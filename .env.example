# ── Next.js + Convex CLI: copia este archivo a .env.local (ignorado por git) ──

# Convex self-hosted (docker compose).
# La admin key se genera con: docker compose exec convex-backend ./generate_admin_key.sh
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# Clerk. Dashboard de Clerk → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Variables del backend Convex ─────────────────────────────────────────────
# No van en .env.local: se configuran en el deployment con
#   npx convex env set NOMBRE valor
#
# CLERK_JWT_ISSUER_DOMAIN   Issuer de Clerk (p. ej. https://xxx.clerk.accounts.dev)
# N8N_WEBHOOK_BASE_URL      http://n8n:5678/webhook  (nombre del servicio en la red de Docker)
# CONVEX_TO_N8N_SECRET      Mismo valor que en infra/n8n.env
# N8N_TO_CONVEX_SECRET      Mismo valor que en infra/n8n.env
