# Copia este archivo a infra/n8n.env (ignorado por git) y completa los valores.
# Genera cada secreto con:  openssl rand -hex 32

# Cifra las credenciales que guardes dentro de n8n. No lo cambies después de crear credenciales.
N8N_ENCRYPTION_KEY=

# Secreto HMAC para verificar los webhooks que Convex envía a n8n.
# Debe ser el mismo valor que CONVEX_TO_N8N_SECRET en Convex.
CONVEX_TO_N8N_SECRET=

# Secreto HMAC para firmar las llamadas que n8n hace a Convex.
# Debe ser el mismo valor que N8N_TO_CONVEX_SECRET en Convex.
N8N_TO_CONVEX_SECRET=
