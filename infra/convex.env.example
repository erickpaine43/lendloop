# Copia este archivo a infra/convex.env (ignorado por git) y completa los valores.

# Nombre de la instancia self-hosted de Convex.
INSTANCE_NAME=lendloop-local

# Secreto de la instancia (64 caracteres hex). Genera uno con:
#   openssl rand -hex 32
# A partir de él se crea la admin key con:
#   docker compose exec convex-backend ./generate_admin_key.sh
INSTANCE_SECRET=
