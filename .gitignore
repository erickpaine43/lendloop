# ─── Secrets and environment ─────────────────────────────────────────────────
# Real env files are never committed; only the *.env.example templates are.
.env
.env.*
!.env.example
infra/*.env
!infra/*.env.example
*.pem
*.key

# ─── Dependencies ────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js / build output ──────────────────────────────────────────────────
/.next/
/out/
/build
.vercel
*.tsbuildinfo
next-env.d.ts

# ─── Convex ──────────────────────────────────────────────────────────────────
# convex/_generated IS committed (Convex recommends it). Local CLI state is not.
.convex/

# ─── n8n ─────────────────────────────────────────────────────────────────────
# Workflows are exported to n8n/*.json and committed. Local n8n data is not.
.n8n/
n8n-data/

# ─── Testing ─────────────────────────────────────────────────────────────────
/coverage
/test-results/
/playwright-report/

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Editor, OS and local tooling ────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.claude/

# ─── Personal notes ──────────────────────────────────────────────────────────
_privado/
